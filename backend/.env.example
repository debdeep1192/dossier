PORT=3001
NODE_ENV=development

# Generate your own secret before running in any shared/production environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If JWT_SECRET is left unset, the server auto-generates a random secret at
# startup for local development convenience — see src/server.js. This is fine
# for local testing but means sessions won't survive a server restart; set a
# fixed value here for anything longer-lived. On Render, set this as a real
# environment variable (or let Render's "generateValue" handle it via
# render.yaml) — never rely on the auto-generated fallback in production.
JWT_SECRET=replace-with-your-own-generated-secret

# Production/staging only: a real hosted PostgreSQL connection string
# (e.g. from Neon). When unset, the app falls back to local PGlite for
# development convenience only — PGlite must never hold real trip/research
# data long-term. Example Neon format:
#   postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Production only: the exact Netlify frontend URL, used to restrict CORS
# to only that origin. Leaving this unset in production blocks all
# cross-origin requests (fails closed, not open).
#   e.g. https://your-app-name.netlify.app
FRONTEND_URL=

